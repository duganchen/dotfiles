theme = Catppuccin Macchiato

# The split-pane navigation keys conflict with GNOME's shortcuts:

keybind=ctrl+alt+arrow_down=unbind
keybind=ctrl+alt+arrow_left=unbind
keybind=ctrl+alt+arrow_right=unbind
keybind=ctrl+alt+arrow_up=unbind

# So I'm using these, which will conflict with both i3's
# https://i3wm.org/docs/refcard.html

# Taking some inspiration from here:
# https://github.com/smart-splits-nvim/backend-ghostty

keybind = performable:alt+h=goto_split:left
keybind = performable:alt+j=goto_split:down
keybind = performable:alt+k=goto_split:up
keybind = performable:alt+l=goto_split:right

# I'm not using transparency for now, but for legacy reasons,
# most of my applications are set up to support a transparent terminal.

# This doesn't seem to make a difference to Yazi, FWIW
window-theme = dark

theme = Catppuccin Macchiato

# The split-pane navigation keys conflict with GNOME's shortcuts:

keybind=ctrl+alt+arrow_down=unbind
keybind=ctrl+alt+arrow_left=unbind
keybind=ctrl+alt+arrow_right=unbind
keybind=ctrl+alt+arrow_up=unbind

# So use Terminator's.
keybind = performable:alt+arrow_left=goto_split:left
keybind = performable:alt+arrow_down=goto_split:down
keybind = performable:alt+arrow_up=goto_split:up
keybind = performable:alt+arrow_right=goto_split:right

# Resizing splits (ctrl+shift+cursor in Terminator) isn't bound because
# it doesn't work well for me. Use the mouse.

# Match these popular binding for tmux, which I admit are easier
keybind=ctrl+shift+e=unbind
keybind=ctrl+shift+-=new_split:down
keybind=ctrl+shift+o=unbind
keybind=ctrl+shift+|=new_split:right

# And Terminator's split-auto keybinding
keybind = ctrl+shift+a=new_split:auto

